 "lines": [
  {
   "id": "x01",
   "at": 0.6,
   "text": "Before a supplier meeting, an executive gets a forty-page pack."
  },
  {
   "id": "x02",
   "at": 5.1,
   "text": "Spend, contracts, sourcing history, risk, news. Pulled from a dozen different systems."
  },
  {
   "id": "x03",
   "at": 12.6,
   "text": "Here's the same briefing, on one screen."
  },
  {
   "id": "x04",
   "at": 16.5,
   "text": "Meet Executive Supplier Intelligence.",
   "caption": false
  },
  {
   "id": "x05",
   "at": 20.9,
   "text": "The headline numbers sit up top: spend, contracts, sourcing events, and an overall risk rating. Red, amber or green."
  },
  {
   "id": "x06",
   "at": 30.5,
   "text": "Below them, three leadership priorities, each with a next step, and the system it came from."
  },
  {
   "id": "x07",
   "at": 36.8,
   "text": "Every detail is one tab away. Spend and exposure, sourcing history, risk, contracts, the supplier as a Vodafone customer, and the latest news."
  },
  {
   "id": "x08",
   "at": 48.0,
   "text": "Switch supplier in a click."
  },
  {
   "id": "x09",
   "at": 50.2,
   "text": "For listed companies, the live share price comes with it."
  },
  {
   "id": "x10",
   "at": 54.4,
   "text": "News starts from primary sources: the company's website, financial and sustainability reports, investor relations, and SEC filings. Then trusted publishers, and any source you add."
  },
  {
   "id": "x11",
   "at": 67.6,
   "text": "Compare up to four suppliers side by side. Microsoft, Huawei and Nokia: lowest exposure, best performance, lowest risk, nearest renewal."
  },
  {
   "id": "x12",
   "at": 79.0,
   "text": "Need it on paper? Generate the briefing, talking points included, as a designed PDF."
  },
  {
   "id": "x13",
   "at": 85.8,
   "text": "Or just ask. Which contract renews next? The answer comes from the underlying data, with its source."
  },
  {
   "id": "x14",
   "at": 93.8,
   "text": "Forty pages, on one screen. Ready before the meeting starts."
  },
  {
   "id": "x15",
   "at": 100.6,
   "text": "Executive Supplier Intelligence. The whole supplier, at a glance.",
   "caption": false
  }
 ],
