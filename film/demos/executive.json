 "lines": [
  {
   "id": "y01",
   "at": 0.8,
   "text": "Forty-five minutes until the Huawei review."
  },
  {
   "id": "y02",
   "at": 4.2,
   "text": "The briefing pack? | Slides, spreadsheets and reports, | from a dozen different systems."
  },
  {
   "id": "y03",
   "at": 11.2,
   "text": "And all you really need to know is: | how much we spend, | how risky they are, | and what's coming up."
  },
  {
   "id": "y04",
   "at": 18.6,
   "text": "Now, | it's one screen.",
   "caption": false
  },
  {
   "id": "y05",
   "at": 22.8,
   "text": "Executive Supplier Intelligence.",
   "caption": false
  },
  {
   "id": "y06",
   "at": 26.8,
   "text": "The headline numbers sit up top. | Spend, | contracts, | sourcing events, | and an overall risk rating: | red, amber or green."
  },
  {
   "id": "y07",
   "at": 37.9,
   "text": "Below them, three leadership priorities, | each with a next step, | and the system it came from."
  },
  {
   "id": "y08",
   "at": 44.9,
   "text": "Every detail is one tab away. | Spend and exposure, | sourcing history, | risk, | contracts, | the supplier as a Vodafone customer, | and the latest news."
  },
  {
   "id": "y09",
   "at": 57.4,
   "text": "Switching supplier takes one click."
  },
  {
   "id": "y10",
   "at": 60.2,
   "text": "For listed companies, | the live share price comes with it."
  },
  {
   "id": "y11",
   "at": 64.7,
   "text": "The news starts with primary sources. | The company's own website, | financial and sustainability reports, | investor relations, | and SEC filings. | Then trusted publishers, | and any source you add."
  },
  {
   "id": "y12",
   "at": 80.3,
   "text": "Compare up to four suppliers, side by side. | Lowest exposure, | best performance, | lowest risk, | and the nearest renewal."
  },
  {
   "id": "y13",
   "at": 90.5,
   "text": "Need it on paper? | Generate a designed briefing, | talking points included."
  },
  {
   "id": "y14",
   "at": 96.6,
   "text": "Or simply ask. | Which contract renews next? | The answer comes straight from the underlying data, | with its source."
  },
  {
   "id": "y15",
   "at": 105.8,
   "text": "Everything you need, on one screen. | Ready, | with time to spare."
  },
  {
   "id": "y16",
   "at": 112.2,
   "text": "Executive Supplier Intelligence. | The whole supplier, at a glance.",
   "caption": false
  }
 ]
}