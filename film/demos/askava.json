 "lines": [
  {
   "id": "b01",
   "at": 0.6,
   "text": "Across Vodafone, category managers, buyers and local market teams ask hundreds of questions every day."
  },
  {
   "id": "b02",
   "at": 7.7,
   "text": "About contracts, sourcing, suppliers, and process."
  },
  {
   "id": "b03",
   "at": 11.9,
   "text": "Meet Ask Ava, your A.I. procurement assistant."
  },
  {
   "id": "b04",
   "at": 16.3,
   "text": "It brings process guidance, contracts, supplier information and business data together in one place, grounded in approved documents."
  },
  {
   "id": "b05",
   "at": 25.0,
   "text": "A buyer needs to raise a purchase order."
  },
  {
   "id": "b06",
   "at": 28.4,
   "text": "Ask Ava walks them through it, step by step."
  },
  {
   "id": "b07",
   "at": 33.1,
   "text": "Submitting an invoice?"
  },
  {
   "id": "b08",
   "at": 37.0,
   "text": "Get the steps, and what to do if it is rejected."
  },
  {
   "id": "b09",
   "at": 41.3,
   "text": "Every answer cites its sources, so you can trust it."
  },
  {
   "id": "b10",
   "at": 45.0,
   "text": "Raise a requisition."
  },
  {
   "id": "b11",
   "at": 51.3,
   "text": "Check an order's status."
  },
  {
   "id": "b12",
   "at": 54.2,
   "text": "No more searching through files."
  },
  {
   "id": "b13",
   "at": 57.7,
   "text": "Supplier questions too, from onboarding to everyday tasks."
  },
  {
   "id": "b14",
   "at": 62.1,
   "text": "And for category managers, it goes deep into contract data."
  },
  {
   "id": "b15",
   "at": 66.5,
   "text": "Liquidated damages rates and caps, across every contract, in seconds."
  },
  {
   "id": "b16",
   "at": 72.7,
   "text": "Right down to where they are defined."
  },
  {
   "id": "b17",
   "at": 78.5,
   "text": "Clear, contextual answers, exactly when they are needed."
  },
  {
   "id": "b18",
   "at": 82.5,
   "text": "Faster answers. Fewer files. More confidence."
  },
  {
   "id": "b19",
   "at": 87.7,
   "text": "Ask Ava. Answers, just a question away.",
   "caption": false
  }
 ]
