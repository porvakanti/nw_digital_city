 "questions": {
  "q1ask": "How do I submit an invoice against a PO in Ariba?",
  "q2ask": "How do I create a PR?",
  "q3ask": "How do I check the status of a PO?",
  "ldask": "Can you give the liquidated damages rate and cap for different contracts?"
 },
 "lines": [
  {
   "id": "a01",
   "at": 0.6,
   "text": "Every day, procurement teams ask the same questions."
  },
  {
   "id": "a02",
   "at": 4.2,
   "text": "And the answers are buried in documents."
  },
  {
   "id": "a03",
   "at": 7.4,
   "text": "Meet AskAVA, your A.I. procurement assistant."
  },
  {
   "id": "a04",
   "at": 12.3,
   "text": "It brings process guides, policies, contracts and supplier know-how together, in one place."
  },
  {
   "id": "a05",
   "at": 18.7,
   "text": "Just ask, in plain English."
  },
  {
   "id": "a06",
   "at": 22.6,
   "text": "AskAVA answers step by step, from approved procurement documents."
  },
  {
   "id": "a07",
   "at": 27.6,
   "text": "And every answer shows its sources, so you can trust it."
  },
  {
   "id": "a08",
   "at": 31.5,
   "text": "Raise a requisition."
  },
  {
   "id": "a09",
   "at": 38.4,
   "text": "Check an order's status."
  },
  {
   "id": "a10",
   "at": 41.2,
   "text": "No more searching through files."
  },
  {
   "id": "a11",
   "at": 45.4,
   "text": "And it goes beyond process, into your contract data."
  },
  {
   "id": "a12",
   "at": 49.6,
   "text": "Ask for liquidated damages across your contracts, and get every rate and cap, in seconds."
  },
  {
   "id": "a13",
   "at": 55.8,
   "text": "Right down to where it is defined in the contract."
  },
  {
   "id": "a14",
   "at": 61.6,
   "text": "Faster answers. Fewer files. More confidence."
  },
  {
   "id": "a15",
   "at": 68.6,
   "text": "AskAVA. Answers, just a question away.",
   "caption": false
  }
 ],
