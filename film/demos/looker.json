 "lines": [
  {
   "id": "k01",
   "at": 0.8,
   "text": "Every day, the business runs on questions."
  },
  {
   "id": "k02",
   "at": 4.3,
   "text": "Which markets are growing? | Where is our traffic coming from? | What changed this year?",
   "caption": false
  },
  {
   "id": "k03",
   "at": 10.8,
   "text": "Getting an answer usually means | navigating reports, | applying filters, | and exporting data."
  },
  {
   "id": "k04",
   "at": 18.5,
   "text": "What if you could just ask?",
   "caption": false
  },
  {
   "id": "k05",
   "at": 21.0,
   "text": "Conversational Analytics, | in Looker.",
   "caption": false
  },
  {
   "id": "k06",
   "at": 25.2,
   "text": "It's built right into Looker. | From the home page, | open Conversations."
  },
  {
   "id": "k07",
   "at": 30.9,
   "text": "Each agent knows one business domain. | Permanent Roamers, | Silent Roamers, | and Wholesale Insights."
  },
  {
   "id": "k08",
   "at": 39.3,
   "text": "Open one, | and it shows you where to start: | suggested questions, | your conversation history, | and exactly what data the agent can see."
  },
  {
   "id": "k09",
   "at": 49.6,
   "text": "Now, | ask in plain English."
  },
  {
   "id": "k10",
   "at": 55.3,
   "text": "In seconds, the answer. | A chart for the trend, | a table for the detail, | and the key insights, in plain words."
  },
  {
   "id": "k11",
   "at": 64.3,
   "text": "Spain leads on inbound traffic. | The UK is growing fastest, | up thirty-nine percent."
  },
  {
   "id": "k12",
   "at": 71.5,
   "text": "Want to know how it got there? | Show thinking walks you through the reasoning, | step by step."
  },
  {
   "id": "k13",
   "at": 78.3,
   "text": "To go deeper, | open it in Explore. | Refine the query, | change dimensions and measures, | and keep investigating."
  },
  {
   "id": "k14",
   "at": 87.3,
   "text": "Then save it to a dashboard, | and it stays live. | Change a filter, | and the data refreshes."
  },
  {
   "id": "k15",
   "at": 94.8,
   "text": "From question, | to insight, | in one conversation."
  },
  {
   "id": "k16",
   "at": 101.2,
   "text": "Conversational Analytics. | Just ask.",
   "caption": false
  }
 ]
