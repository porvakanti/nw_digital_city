 "lines": [
  {
   "id": "h01",
   "at": 0.6,
   "text": "Every hardware renewal comes down to one question."
  },
  {
   "id": "h02",
   "at": 3.9,
   "text": "What should this cost, today?"
  },
  {
   "id": "h03",
   "at": 6.4,
   "text": "Components move. Currencies move. Without a current cost, you negotiate on an old number."
  },
  {
   "id": "h04",
   "at": 14.0,
   "text": "Meet D to C Product Re-costing.",
   "caption": false
  },
  {
   "id": "h05",
   "at": 18.4,
   "text": "In the D to C Assistant, choose the hardware stream, then product costing."
  },
  {
   "id": "h06",
   "at": 23.6,
   "text": "Search by L4 code, vendor, or product name."
  },
  {
   "id": "h07",
   "at": 27.9,
   "text": "Pick the vendor. Here, Nokia."
  },
  {
   "id": "h08",
   "at": 31.2,
   "text": "Then the product model."
  },
  {
   "id": "h09",
   "at": 35.0,
   "text": "D to C re-costs it against the latest data."
  },
  {
   "id": "h10",
   "at": 39.0,
   "text": "Original cost: two thousand, eight hundred and twenty-one dollars, in March 2024. Latest cost: three thousand, one hundred and twenty-four. Up almost eleven percent."
  },
  {
   "id": "h11",
   "at": 52.2,
   "text": "And the full cost history is one download away."
  },
  {
   "id": "h12",
   "at": 56.0,
   "text": "Any vendor. Any model. The current cost, in seconds."
  },
  {
   "id": "h13",
   "at": 64.6,
   "text": "Know the number before the supplier names it.",
   "caption": false
  }
 ],
 "captionMap": {
  "D to C": "D2C"
 }
