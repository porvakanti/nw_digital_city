 "lines": [
  {
   "id": "s01",
   "at": 0.6,
   "text": "How many man-days should this project take? At what rate? In which market?"
  },
  {
   "id": "s02",
   "at": 6.5,
   "text": "For software services, the answer is usually the supplier's quote.",
   "caption": false
  },
  {
   "id": "s03",
   "at": 11.6,
   "text": "Meet D to C Should Cost, for software services.",
   "caption": false
  },
  {
   "id": "s04",
   "at": 16.3,
   "text": "In the D to C Assistant, choose software services, then should cost."
  },
  {
   "id": "s05",
   "at": 21.3,
   "text": "Pick the project. Here, system integration, for application integration."
  },
  {
   "id": "s06",
   "at": 27.3,
   "text": "Set the complexity, and the market. Medium complexity, delivered in Portugal."
  },
  {
   "id": "s07",
   "at": 33.7,
   "text": "D to C brings in the benchmark: a blended rate of two hundred and ninety-four euros, with an eighty-twenty onshore, offshore mix."
  },
  {
   "id": "s08",
   "at": 42.3,
   "text": "Name the project. Add the volume, contract term and confidence level. And calculate."
  },
  {
   "id": "s09",
   "at": 51.9,
   "text": "The result is a should-cost range. Best case, six hundred and four thousand euros. Ideal, six hundred and fifty-seven thousand. Worst case, seven hundred and ten thousand."
  },
  {
   "id": "s10",
   "at": 65.3,
   "text": "With the effort behind it in man-days, and the benchmark it came from."
  },
  {
   "id": "s11",
   "at": 70.0,
   "text": "A defensible number, before the first quote arrives."
  },
  {
   "id": "s12",
   "at": 77.0,
   "text": "Know what it should cost, before you negotiate.",
   "caption": false
  }
 ],
