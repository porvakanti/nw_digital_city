  "lines": [
    {"id": "m01", "at": 0.6, "text": "Technology only delivers value when people use it. Digital City makes adoption visible, and gives every team a reason to keep going."},
    {"id": "m02", "at": 10.6, "text": "Every category is a plot of land."},
    {"id": "m03", "at": 14.3, "text": "As teams adopt, their buildings grow,"},
    {"id": "m04", "at": 17.8, "text": "from traditional, to connected,"},
    {"id": "m05", "at": 22.2, "text": "Using A.I. unlocks the next level."},
    {"id": "m06", "at": 26.6, "text": "Every milestone earns a landmark."},
    {"id": "m07", "at": 29.3, "text": "Everyday actions, made visible."},
    {"id": "m08", "at": 32.2, "text": "The league shows who is leading, and where the opportunities are."},
    {"id": "m09", "at": 36.4, "text": "We celebrate our champions, learn from them, and focus support where it matters most."},
    {"id": "m10", "at": 42.6, "text": "Atlas, our A.I. guide, shows every team its next move."},
    {"id": "m11", "at": 49.6, "text": "Our ambition is simple: make adoption engaging, build healthy competition, and turn digital investment into everyday habits."},
    {"id": "m12", "at": 59.4, "text": "Your move."}
