  "lines": [
    {"id": "n00", "at": 0.8, "text": "Imagine procurement as a city.", "caption": false},
    {"id": "m01", "at": 3.6, "text": "Technology only delivers value when people use it. Digital City makes adoption visible, and gives every team a reason to keep going."},
    {"id": "m02", "at": 13.8, "text": "Every category is a plot of land."},
    {"id": "m03", "at": 17.5, "text": "As teams adopt, their buildings grow,"},
    {"id": "m04", "at": 21.0, "text": "from traditional, to connected."},
    {"id": "n05", "at": 25.4, "text": "Using the blueprint unlocks the next level: smart."},
    {"id": "n06", "at": 29.8, "text": "Using A.I. completes the journey: autonomous."},
    {"id": "n07", "at": 33.0, "text": "Every milestone earns a landmark."},
    {"id": "m08", "at": 35.4, "text": "The league shows who is leading, and where the opportunities are."},
    {"id": "m09", "at": 39.5, "text": "We celebrate our champions, learn from them, and focus support where it matters most."},
    {"id": "m10", "at": 45.3, "text": "Atlas, our A.I. guide, shows every team its next move."},
    {"id": "m11", "at": 52.3, "text": "Our ambition is simple: make adoption engaging, build healthy competition, and turn digital investment into everyday habits."},
    {"id": "m12", "at": 61.5, "text": "Your move."}
