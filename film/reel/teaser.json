  "lines": [
    {"id": "t01", "at": 0.8,  "text": "Imagine procurement as a city."},
    {"id": "t02", "at": 3.9,  "text": "Every category we buy is a plot of land."},
    {"id": "t03", "at": 8.6,  "text": "Welcome to Digital City, where adoption is a game."},
    {"id": "t04", "at": 13.4, "text": "Write a blueprint, and you stake your claim."},
    {"id": "t05", "at": 16.4, "text": "Take it live, and your building rises."},
    {"id": "t06", "at": 19.6, "text": "Use it, let A.I. write the brief, and the lights come on."},
    {"id": "t07", "at": 23.5, "text": "The more you adopt, the higher you climb, from traditional to autonomous."},
    {"id": "t08", "at": 28.1, "text": "Every district sees exactly where it stands."},
    {"id": "t09", "at": 31.2, "text": "And healthy competition drives adoption."},
    {"id": "t10", "at": 34.7, "text": "Switch to night mode, and the leaders light up the skyline."},
    {"id": "t11", "at": 40.8, "text": "As adoption spreads, the whole city rises."},
    {"id": "t12", "at": 44.1, "text": "This is how we gamify adoption in V P and C."},
    {"id": "t13", "at": 47.9, "text": "Digital City. Adoption, gamified."}
  ]
