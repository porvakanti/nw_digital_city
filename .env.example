# Copy to .env and fill in. .env is git-ignored and must stay that way.

# mock | gemini | vertex | claude
NW_PROVIDER=mock

# gemini or claude: the API key. Never commit this.
NW_API_KEY=

# vertex: no key. Authenticates with application default credentials.
NW_PROJECT=
NW_REGION=global

# Optional overrides.
# Leave NW_MODEL unset and a live model is chosen for you, which matters
# because providers retire model names. `run.cmd models` lists what your key
# can actually call.
# NW_MODEL=gemini-3.5-flash
# NW_TIMEOUT=30
# NW_ALLOW_ORIGINS=*
# NW_FRAME_ANCESTORS lists who may embed the city in an iframe. Unset means
# nobody can, which is the right default. For the Agent Marketplace:
# NW_FRAME_ANCESTORS=https://your-marketplace.streamlit.app https://*.vodafone.com
